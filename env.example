# Copia este archivo como ".env" (junto al docker-compose.yml) y cambia los valores.
# NO subas el .env a Git.
#
# Evita ";" "=" y "$" en la contraseña: se usa dentro de la cadena de conexión
# y Compose interpreta "$" como variable.
MYSQL_ROOT_PASSWORD=cambia_esta_clave
MYSQL_DATABASE=CP_AggronomyProject
ASPNETCORE_ENVIRONMENT=Production
