@model ProyectoAgroEspinosa_2026.Models.L_Inventory

<div class="form-page">
    <h2 class="form-title">Modificar Inventario</h2>
    <div class="form-card">
        <form asp-controller="Inventario" asp-action="Editar" method="post" autocomplete="off" id="formInventario">
            <input type="hidden" asp-for="idInventario" />
            <div class="form-grid">

                <div class="mb-3">
                    <label class="form-label">Nombre</label>
                    <input type="text" class="form-control border-success"
                           maxlength="100" asp-for="nombre" required />
                    <span class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Unidad de Medida</label>
                    <input type="text" class="form-control border-success"
                           maxlength="20" asp-for="unidadmedida" required />
                    <span class="field-error"></span>
                </div>

                <div class="mb-3 field-span2">
                    <label class="form-label">Descripción</label>
                    <input type="text" class="form-control border-success"
                           maxlength="250" asp-for="descripcion" required />
                    <span class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Stock Actual</label>
                    <input type="number" class="form-control border-success"
                           min="0" max="1000000" asp-for="stockactual" required />
                    <span class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Stock Mínimo</label>
                    <input type="number" class="form-control border-success"
                           min="0" max="1000000" asp-for="stockminimo" required />
                    <span class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Fecha de Actualización</label>
                    <input type="date" class="form-control border-success" asp-for="fechaactualizacion" required />
                    <span class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Estado</label>
                    <select class="form-select border-success" asp-for="estado" required>
                        <option value="true">Activo</option>
                        <option value="false">Inactivo</option>
                    </select>
                </div>

                <div class="mb-3">
                    <label class="form-label">Producto Inicial</label>
                    <select class="form-select border-success" asp-for="idProductoInicial" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var p in (List<ProyectoAgroEspinosa_2026.Models.E_Initial_Product>)ViewBag.ProductosIniciales)
                        {
                            <option value="@p.idProductoInicial">@p.nombre</option>
                        }
                    </select>
                    <span class="field-error"></span>
                </div>

                <div class="mb-3">
                    <label class="form-label">Producto Final</label>
                    <select class="form-select border-success" asp-for="idProductoFinal" required>
                        <option value="">-- Seleccione --</option>
                        @foreach (var p in (List<ProyectoAgroEspinosa_2026.Models.E_Final_Product>)ViewBag.ProductosFinales)
                        {
                            <option value="@p.idProductoFinal">@p.nombre</option>
                        }
                    </select>
                    <span class="field-error"></span>
                </div>

            </div>
            <div class="form-actions">
                <a asp-controller="Inventario" asp-action="Listar" class="btn-cancel">
                    <i class="material-icons" style="font-size: 18px;">cancel</i> Cancelar
                </a>
                <button type="submit" class="btn-submit">
                    <i class="material-icons" style="font-size: 18px;">done</i> Actualizar
                </button>
            </div>
        </form>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/inventario/inventario.css" asp-append-version="true" />
}

@section Scripts {
    <link href="https://fonts.googleapis.com/icon?family=Material+Icons" rel="stylesheet">
    <script src="~/js/inventario/inventario.js" asp-append-version="true"></script>
}