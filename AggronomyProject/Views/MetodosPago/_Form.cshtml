@model MetodoPago
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="form-grid">
    <div class="mb-3">
        <label asp-for="nombre" class="form-label">Nombre</label>
        <input asp-for="nombre" class="form-control" placeholder="Efectivo, transferencia, Yape" />
        <span asp-validation-for="nombre" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="id_pago" class="form-label">Pago asociado</label>
        <select asp-for="id_pago" asp-items="(SelectList)ViewBag.id_pago" class="form-select">
            <option value="">Seleccione un pago</option>
        </select>
        <span asp-validation-for="id_pago" class="text-danger small"></span>
    </div>
    <div class="mb-3 span-all">
        <label asp-for="descripcion" class="form-label">Descripción</label>
        <input asp-for="descripcion" class="form-control" />
        <span asp-validation-for="descripcion" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3 span-all">
        <input asp-for="estado" class="form-check-input" />
        <label asp-for="estado" class="form-check-label">Método activo</label>
    </div>
</div>
