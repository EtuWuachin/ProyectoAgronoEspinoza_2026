@model MetodoPago
@{
    ViewData["Title"] = "Nuevo método de pago";
}
<div class="page-header">
    <div><h1>Nuevo método de pago</h1><p>Agregue una forma de pago al catálogo</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>
<form asp-action="Create" class="form-panel">
    <partial name="_Form" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Guardar método</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
