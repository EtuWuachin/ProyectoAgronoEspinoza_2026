@model IEnumerable<MetodoPago>
@{
    ViewData["Title"] = "Métodos de pago";
}
<div class="page-header">
    <div><h1>Métodos de pago</h1><p>Catálogo de formas de pago</p></div>
    <a class="btn btn-primary" asp-action="Create">Nuevo método</a>
</div>
<div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>Método</th><th>Descripción</th><th>Pago asociado</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var m in Model)
        {
            <tr>
                <td><strong>@m.nombre</strong></td>
                <td>@m.descripcion</td>
                <td>@if (m.pago != null) { <a asp-controller="Pagos" asp-action="Details" asp-route-id="@m.id_pago">@m.pago.comprobante</a> }</td>
                <td><partial name="_EstadoBadge" model="m.estado" /></td>
                <td class="table-actions"><partial name="_EstadoButton" model='new EstadoToggle("MetodosPago", m.IdMetodoPago, m.estado)' /></td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr class="empty-row"><td colspan="5">No hay métodos de pago. Agregue uno con “Nuevo método”.</td></tr>
        }
        </tbody>
    </table>
</div>
