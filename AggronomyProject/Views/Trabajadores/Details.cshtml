@model Trabajador
@{
    ViewData["Title"] = Model.nombres + " " + Model.apellidos;
}
<div class="page-header">
    <div><h1>@Model.nombres @Model.apellidos</h1><p>@Model.cargo</p></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.id_trabajador">Editar</a>
    </div>
</div>
<div class="panel mb-4">
    <dl class="detail-list">
        <dt>DNI</dt><dd>@Model.dni</dd>
        <dt>Teléfono</dt><dd>@Model.telefono</dd>
        <dt>Correo</dt><dd>@Model.email</dd>
        <dt>Fecha de contrato</dt><dd>@Model.fecha_contrato.ToString("dd/MM/yyyy")</dd>
        <dt>Estado</dt><dd><partial name="_EstadoBadge" model="Model.estado" /></dd>
    </dl>
</div>
<div class="panel">
    <div class="panel-title"><h2>Operaciones en las que participa</h2></div>
    @if (Model.administracion == null || !Model.administracion.Any())
    {
        <p class="empty-note">Este trabajador aún no figura en ninguna operación.</p>
    }
    else
    {
        @foreach (var a in Model.administracion.OrderByDescending(x => x.fecha_registro))
        {
            <div class="restock-row"><span>@a.nombre</span><span class="restock-meta">@a.fecha_registro.ToString("dd/MM/yyyy")</span></div>
        }
    }
</div>
