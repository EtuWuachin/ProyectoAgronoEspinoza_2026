@model RecursosAdministrador
@{
    ViewData["Title"] = "Nueva acta de recepción";
}
<div class="page-header">
    <div><h1>Nueva acta de recepción</h1><p>Registre lo que se recibió y cualquier observación</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>
<form asp-action="Create" class="form-panel">
    <partial name="_Form" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Guardar acta</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
