@model Recurso
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="form-grid">
    <div class="mb-3">
        <label asp-for="id_proveedor" class="form-label">Proveedor</label>
        <select asp-for="id_proveedor" asp-items="(SelectList)ViewBag.id_proveedor" class="form-select">
            <option value="">Seleccione un proveedor</option>
        </select>
        <span asp-validation-for="id_proveedor" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="tipo_recurso" class="form-label">Tipo de recurso</label>
        <input asp-for="tipo_recurso" class="form-control" placeholder="Semilla, fertilizante, herramienta" />
        <span asp-validation-for="tipo_recurso" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="fecha_ingreso" class="form-label">Fecha de ingreso</label>
        <input asp-for="fecha_ingreso" type="date" class="form-control" />
        <span asp-validation-for="fecha_ingreso" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="cantidad_recibida" class="form-label">Cantidad recibida</label>
        <input asp-for="cantidad_recibida" type="number" min="1" class="form-control" />
        <span asp-validation-for="cantidad_recibida" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="unidad_medida" class="form-label">Unidad de medida</label>
        <input asp-for="unidad_medida" class="form-control" placeholder="kg, sacos, unidades" />
        <span asp-validation-for="unidad_medida" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="costo_recurso" class="form-label">Costo (S/)</label>
        <input asp-for="costo_recurso" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="costo_recurso" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3 span-all">
        <input asp-for="estado" class="form-check-input" />
        <label asp-for="estado" class="form-check-label">Recurso activo</label>
    </div>
</div>
