@model Pago
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<div class="form-grid">
    <div class="mb-3 span-all">
        <label asp-for="concepto" class="form-label">Concepto</label>
        <input asp-for="concepto" class="form-control" />
        <span asp-validation-for="concepto" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="monto" class="form-label">Monto (S/)</label>
        <input asp-for="monto" type="number" step="0.01" min="0.01" class="form-control" />
        <span asp-validation-for="monto" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="fecha_pago" class="form-label">Fecha de pago</label>
        <input asp-for="fecha_pago" type="date" class="form-control" />
        <span asp-validation-for="fecha_pago" class="text-danger small"></span>
    </div>
    <div class="mb-3 span-all">
        <label asp-for="comprobante" class="form-label">Número de comprobante</label>
        <input asp-for="comprobante" class="form-control" placeholder="COMP-0002" />
        <span asp-validation-for="comprobante" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3 span-all">
        <input asp-for="estado" class="form-check-input" />
        <label asp-for="estado" class="form-check-label">Pago vigente</label>
    </div>
</div>
