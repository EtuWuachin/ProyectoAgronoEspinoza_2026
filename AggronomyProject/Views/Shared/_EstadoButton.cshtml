@model EstadoToggle
<form asp-controller="@Model.Controller" asp-action="CambiarEstado" method="post" class="d-inline"
      data-confirm="@(Model.Estado ? "¿Desactivar este registro?" : "¿Activar este registro?")">
    <input type="hidden" name="id" value="@Model.Id" />
    <button type="submit" class="link-btn @(Model.Estado ? "is-danger" : "")">@(Model.Estado ? "Desactivar" : "Activar")</button>
</form>
