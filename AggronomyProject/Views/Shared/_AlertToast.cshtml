@if (TempData["Success"] != null || TempData["Error"] != null)
{
    <div class="toast-stack" aria-live="polite" aria-atomic="true">
        @if (TempData["Success"] is string exito)
        {
            <div class="toast align-items-center text-bg-success border-0" role="status">
                <div class="d-flex">
                    <div class="toast-body">@exito</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
        @if (TempData["Error"] is string error)
        {
            <div class="toast align-items-center text-bg-danger border-0 mt-2" role="alert">
                <div class="d-flex">
                    <div class="toast-body">@error</div>
                    <button type="button" class="btn-close btn-close-white me-2 m-auto" data-bs-dismiss="toast" aria-label="Cerrar"></button>
                </div>
            </div>
        }
    </div>
}
