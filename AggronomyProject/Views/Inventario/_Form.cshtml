@model Inventario
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="id_inventario" />
<p class="a11y-instruction">Completa los campos obligatorios. Escribe cuántas unidades hay y el mínimo que necesitas. Si hay un error, corrige el campo indicado sin borrar los otros datos.</p>
<div class="form-grid">
    <div class="mb-3">
        <label asp-for="nombre" class="form-label">Nombre (obligatorio)</label>
        <input asp-for="nombre" class="form-control" aria-describedby="nombreAyuda" />
        <p class="form-hint" id="nombreAyuda">¿Qué producto vas a guardar? Por ejemplo: abono orgánico.</p>
        <span asp-validation-for="nombre" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="unidad_medida" class="form-label">Unidad de medida (obligatoria)</label>
        <input asp-for="unidad_medida" class="form-control" list="unidadesFrecuentes" aria-describedby="unidadAyuda" />
        <datalist id="unidadesFrecuentes">
            <option value="kg">⚖ Kilogramos</option>
            <option value="sacos">📦 Sacos</option>
            <option value="litros">💧 Litros</option>
            <option value="unidades">🔢 Unidades</option>
        </datalist>
        <p class="form-hint" id="unidadAyuda">Elige kg, sacos, litros o unidades. También puedes escribir otra unidad.</p>
        <span asp-validation-for="unidad_medida" class="text-danger small"></span>
    </div>
    <div class="mb-3 span-all">
        <label asp-for="descripcion" class="form-label">Descripción (obligatoria)</label>
        <input asp-for="descripcion" class="form-control" />
        <span asp-validation-for="descripcion" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="stock_actual" class="form-label">Stock actual (obligatorio)</label>
        <input asp-for="stock_actual" type="number" min="0" step="1" class="form-control" aria-describedby="stockAyuda" />
        <p class="form-hint" id="stockAyuda">¿Cuántas unidades hay? Escribe cero si todavía no tienes producto.</p>
        <span asp-validation-for="stock_actual" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="stock_minimo" class="form-label">Stock mínimo (obligatorio)</label>
        <input asp-for="stock_minimo" type="number" min="0" step="1" class="form-control" aria-describedby="minimoAyuda" />
        <div class="form-hint" id="minimoAyuda">¿Cuántas unidades necesitas como mínimo? La alerta aparece cuando el stock llega a esta cantidad o es menor.</div>
        <span asp-validation-for="stock_minimo" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="id_producto_inicial" class="form-label">Insumo base</label>
        <select asp-for="id_producto_inicial" asp-items="(SelectList)ViewBag.id_producto_inicial" class="form-select">
            <option value="">Seleccione un insumo</option>
        </select>
        <span asp-validation-for="id_producto_inicial" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="id_producto_final" class="form-label">Producto final</label>
        <select asp-for="id_producto_final" asp-items="(SelectList)ViewBag.id_producto_final" class="form-select">
            <option value="">Seleccione un producto</option>
        </select>
        <span asp-validation-for="id_producto_final" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3 span-all">
        <input asp-for="estado" class="form-check-input" />
        <label asp-for="estado" class="form-check-label">Artículo activo</label>
    </div>
</div>
