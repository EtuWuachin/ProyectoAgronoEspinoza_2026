@model Reporte
@{
    ViewData["Title"] = "Nuevo reporte";
}
<div class="page-header">
    <div><h1>Nuevo reporte</h1><p>La fecha y el autor se registran automáticamente</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>
<form asp-action="Create" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <div class="form-grid">
        <div class="mb-3">
            <label asp-for="titulo" class="form-label">Título</label>
            <input asp-for="titulo" class="form-control" />
            <span asp-validation-for="titulo" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label asp-for="tipo_reporte" class="form-label">Tipo de reporte</label>
            <input asp-for="tipo_reporte" class="form-control" list="tiposReporte" />
            <datalist id="tiposReporte">
                <option value="Producción"></option>
                <option value="Inventario"></option>
                <option value="Financiero"></option>
                <option value="Personal"></option>
                <option value="General"></option>
            </datalist>
            <span asp-validation-for="tipo_reporte" class="text-danger small"></span>
        </div>
        <div class="mb-3 span-all">
            <label asp-for="contenido" class="form-label">Contenido</label>
            <textarea asp-for="contenido" rows="10" class="form-control"></textarea>
            <span asp-validation-for="contenido" class="text-danger small"></span>
        </div>
    </div>
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Generar reporte</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
