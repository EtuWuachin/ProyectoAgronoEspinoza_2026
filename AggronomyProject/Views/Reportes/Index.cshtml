@model IEnumerable<Reporte>
@{
    ViewData["Title"] = "Reportes";
    var tipos = (List<string>)ViewBag.Tipos;
}
<div class="page-header">
    <div><h1>Reportes</h1><p>Historial de reportes técnicos generados</p></div>
    <a class="btn btn-primary" asp-action="Create">Nuevo reporte</a>
</div>
<form method="get" class="filter-bar">
    <select name="tipo" class="form-select" aria-label="Tipo de reporte">
        <option value="">Todos los tipos</option>
        @foreach (var t in tipos)
        {
            <option value="@t" selected="@((string?)ViewData["tipo"] == t)">@t</option>
        }
    </select>
    <button type="submit" class="btn btn-outline-secondary">Filtrar</button>
</form>
<div class="table-wrap">
    <table class="data-table">
        <thead><tr><th>Título</th><th>Tipo</th><th>Generado</th><th>Autor</th><th>Estado</th><th></th></tr></thead>
        <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@r.id_reporte"><strong>@r.titulo</strong></a></td>
                <td>@r.tipo_reporte</td>
                <td>@r.fecha_generacion.ToString("dd/MM/yyyy HH:mm")</td>
                <td>@r.generado_por</td>
                <td><partial name="_EstadoBadge" model="r.estado" /></td>
                <td class="table-actions">
                    <a asp-action="Details" asp-route-id="@r.id_reporte">Abrir</a>
                    <partial name="_EstadoButton" model='new EstadoToggle("Reportes", r.id_reporte, r.estado)' />
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr class="empty-row"><td colspan="6">No hay reportes. Cree el primero con “Nuevo reporte”.</td></tr>
        }
        </tbody>
    </table>
</div>
