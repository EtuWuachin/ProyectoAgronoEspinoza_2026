@model Proveedor
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="id_proveedor" />
<div class="form-grid">
    <div class="mb-3">
        <label asp-for="nombre" class="form-label">Nombre o razón social</label>
        <input asp-for="nombre" class="form-control" />
        <span asp-validation-for="nombre" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="ruc" class="form-label">RUC</label>
        <input asp-for="ruc" class="form-control" inputmode="numeric" />
        <span asp-validation-for="ruc" class="text-danger small"></span>
    </div>
    <div class="mb-3 span-all">
        <label asp-for="direccion" class="form-label">Dirección</label>
        <input asp-for="direccion" class="form-control" />
        <span asp-validation-for="direccion" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="telefono" class="form-label">Teléfono</label>
        <input asp-for="telefono" type="tel" class="form-control" />
        <span asp-validation-for="telefono" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="email" class="form-label">Correo electrónico</label>
        <input asp-for="email" type="email" class="form-control" />
        <span asp-validation-for="email" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3 span-all">
        <input asp-for="estado" class="form-check-input" />
        <label asp-for="estado" class="form-check-label">Proveedor activo</label>
    </div>
</div>
