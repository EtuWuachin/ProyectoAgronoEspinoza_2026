@model Proveedor
@{
    ViewData["Title"] = Model.nombre;
}
<div class="page-header">
    <div><h1>@Model.nombre</h1><p>Ficha del proveedor</p></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.id_proveedor">Editar</a>
    </div>
</div>
<div class="panel mb-4">
    <dl class="detail-list">
        <dt>RUC</dt><dd>@Model.ruc</dd>
        <dt>Dirección</dt><dd>@Model.direccion</dd>
        <dt>Teléfono</dt><dd>@Model.telefono</dd>
        <dt>Correo</dt><dd>@Model.email</dd>
        <dt>Estado</dt><dd><partial name="_EstadoBadge" model="Model.estado" /></dd>
    </dl>
</div>
<div class="panel">
    <div class="panel-title"><h2>Recursos suministrados</h2><a asp-controller="Recursos" asp-action="Create">Registrar recurso</a></div>
    @if (Model.recurso == null || !Model.recurso.Any())
    {
        <p class="empty-note">Este proveedor aún no tiene recursos registrados.</p>
    }
    else
    {
        <div class="table-wrap">
            <table class="data-table">
                <thead><tr><th>Tipo</th><th>Ingreso</th><th class="num">Cantidad</th><th class="num">Costo</th></tr></thead>
                <tbody>
                @foreach (var r in Model.recurso.OrderByDescending(x => x.fecha_ingreso))
                {
                    <tr>
                        <td><a asp-controller="Recursos" asp-action="Details" asp-route-id="@r.id_recurso">@r.tipo_recurso</a></td>
                        <td>@r.fecha_ingreso.ToString("dd/MM/yyyy")</td>
                        <td class="num">@r.cantidad_recibida @r.unidad_medida</td>
                        <td class="num">S/ @r.costo_recurso.ToString("N2")</td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    }
</div>
