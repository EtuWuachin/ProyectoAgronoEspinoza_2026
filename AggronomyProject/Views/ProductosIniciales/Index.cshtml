@model IEnumerable<ProductoInicial>
@{
    ViewData["Title"] = "Insumos";
}
<div class="page-header">
    <div><h1>Insumos</h1><p>Semillas, fertilizantes y agroquímicos recibidos</p></div>
    <a class="btn btn-primary" asp-action="Create">Nuevo insumo</a>
</div>

<form method="get" class="filter-bar">
    <input type="search" name="q" value="@ViewData["q"]" class="form-control" placeholder="Buscar por nombre o proveedor" aria-label="Buscar" />
    <button type="submit" class="btn btn-outline-secondary">Buscar</button>
</form>

<div class="table-wrap">
    <table class="data-table">
        <thead>
            <tr><th>Insumo</th><th class="num">Cantidad inicial</th><th class="num">Costo unitario</th><th>Ingreso</th><th>Proveedor de origen</th><th>Estado</th><th></th></tr>
        </thead>
        <tbody>
        @foreach (var p in Model)
        {
            <tr>
                <td><a asp-action="Details" asp-route-id="@p.id_producto_inicial"><strong>@p.nombre</strong></a><span class="cell-sub">@p.descripcion</span></td>
                <td class="num">@p.cantidad_inicial @p.unidad_medida</td>
                <td class="num">S/ @p.costo_unitario.ToString("N2")</td>
                <td>@p.fecha_ingreso.ToString("dd/MM/yyyy")</td>
                <td>@p.proveedor_origen</td>
                <td><partial name="_EstadoBadge" model="p.estado" /></td>
                <td class="table-actions">
                    <a asp-action="Edit" asp-route-id="@p.id_producto_inicial">Editar</a>
                    <partial name="_EstadoButton" model='new EstadoToggle("ProductosIniciales", p.id_producto_inicial, p.estado)' />
                </td>
            </tr>
        }
        @if (!Model.Any())
        {
            <tr class="empty-row"><td colspan="7">No hay insumos registrados. Registre el primero con “Nuevo insumo”.</td></tr>
        }
        </tbody>
    </table>
</div>
