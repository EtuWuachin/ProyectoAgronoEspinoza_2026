@model ProductoInicial
@{
    ViewData["Title"] = "Editar insumo";
}
<div class="page-header">
    <div><h1>Editar insumo</h1><p>@Model.nombre</p></div>
    <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
</div>
<form asp-action="Edit" asp-route-id="@Model.id_producto_inicial" class="form-panel">
    <partial name="_Form" />
    <div class="form-actions">
        <button type="submit" class="btn btn-primary">Guardar cambios</button>
        <a asp-action="Index" class="btn btn-link">Cancelar</a>
    </div>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/modules/productos.js" asp-append-version="true"></script>
}
