@model ProductoInicial
@{
    ViewData["Title"] = Model.nombre;
}
<div class="page-header">
    <div><h1>@Model.nombre</h1><p>Detalle del insumo</p></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.id_producto_inicial">Editar</a>
    </div>
</div>
<div class="panel mb-4">
    <dl class="detail-list">
        <dt>Descripción</dt><dd>@Model.descripcion</dd>
        <dt>Cantidad inicial</dt><dd>@Model.cantidad_inicial @Model.unidad_medida</dd>
        <dt>Costo unitario</dt><dd>S/ @Model.costo_unitario.ToString("N2")</dd>
        <dt>Costo del lote</dt><dd>S/ @((Model.cantidad_inicial * Model.costo_unitario).ToString("N2"))</dd>
        <dt>Fecha de ingreso</dt><dd>@Model.fecha_ingreso.ToString("dd/MM/yyyy")</dd>
        <dt>Proveedor de origen</dt><dd>@Model.proveedor_origen</dd>
        <dt>Estado</dt><dd><partial name="_EstadoBadge" model="Model.estado" /></dd>
    </dl>
</div>
<div class="panel">
    <div class="panel-title"><h2>Artículos de inventario que lo usan</h2></div>
    @if (Model.inventario == null || !Model.inventario.Any())
    {
        <p class="empty-note">Este insumo aún no está asignado a un artículo de inventario.</p>
    }
    else
    {
        @foreach (var i in Model.inventario)
        {
            <div class="restock-row">
                <a class="restock-name" asp-controller="Inventario" asp-action="Details" asp-route-id="@i.id_iventario">@i.nombre</a>
                <span>@i.stock_actual @i.unidad_medida</span>
            </div>
        }
    }
</div>
