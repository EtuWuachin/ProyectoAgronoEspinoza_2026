@model ProductoFinal
<div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
<input type="hidden" asp-for="id_producto_final" />
<div class="form-grid">
    <div class="mb-3">
        <label asp-for="nombre" class="form-label">Nombre</label>
        <input asp-for="nombre" class="form-control" />
        <span asp-validation-for="nombre" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="unidad_medida" class="form-label">Unidad de medida</label>
        <input asp-for="unidad_medida" class="form-control" placeholder="kg, sacos, cajas" />
        <span asp-validation-for="unidad_medida" class="text-danger small"></span>
    </div>
    <div class="mb-3 span-all">
        <label asp-for="descripcion" class="form-label">Descripción</label>
        <input asp-for="descripcion" class="form-control" />
        <span asp-validation-for="descripcion" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="cantidad_producida" class="form-label">Cantidad producida</label>
        <input asp-for="cantidad_producida" type="number" min="0" class="form-control" />
        <span asp-validation-for="cantidad_producida" class="text-danger small"></span>
    </div>
    <div class="mb-3">
        <label asp-for="precio_venta" class="form-label">Precio de venta (S/)</label>
        <input asp-for="precio_venta" type="number" step="0.01" min="0" class="form-control" />
        <span asp-validation-for="precio_venta" class="text-danger small"></span>
    </div>
    <div class="form-check mb-3 span-all">
        <input asp-for="estado" class="form-check-input" />
        <label asp-for="estado" class="form-check-label">Producto activo</label>
    </div>
</div>
