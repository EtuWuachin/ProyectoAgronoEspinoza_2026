@model ProductoFinal
@{
    ViewData["Title"] = Model.nombre;
}
<div class="page-header">
    <div><h1>@Model.nombre</h1><p>Detalle de la cosecha</p></div>
    <div class="d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-action="Index">Volver</a>
        <a class="btn btn-primary" asp-action="Edit" asp-route-id="@Model.id_producto_final">Editar</a>
    </div>
</div>
<div class="panel mb-4">
    <dl class="detail-list">
        <dt>Descripción</dt><dd>@Model.descripcion</dd>
        <dt>Cantidad producida</dt><dd>@Model.cantidad_producida @Model.unidad_medida</dd>
        <dt>Precio de venta</dt><dd>S/ @Model.precio_venta.ToString("N2") por @Model.unidad_medida</dd>
        <dt>Valor estimado</dt><dd>S/ @((Model.cantidad_producida * Model.precio_venta).ToString("N2"))</dd>
        <dt>Estado</dt><dd><partial name="_EstadoBadge" model="Model.estado" /></dd>
    </dl>
</div>
<div class="panel">
    <div class="panel-title"><h2>Artículos de inventario asociados</h2></div>
    @if (Model.inventario == null || !Model.inventario.Any())
    {
        <p class="empty-note">Este producto aún no está asignado a un artículo de inventario.</p>
    }
    else
    {
        @foreach (var i in Model.inventario)
        {
            <div class="restock-row">
                <a class="restock-name" asp-controller="Inventario" asp-action="Details" asp-route-id="@i.id_iventario">@i.nombre</a>
                <span>@i.stock_actual @i.unidad_medida</span>
            </div>
        }
    }
</div>
